host: "127.0.0.1"
port: 8317
auth-dir: "~/.cli-proxy-api"
api-keys:
  - "__PROXY_KEY__"
debug: false
# CLIProxyAPI otherwise appends an unrequested {"type":"image_generation"} tool to
# every Codex request. Claude Code never asked for it, and it perturbs the tool
# array that prompt-cache prefix matching needs byte-identical between requests.
# 4-state enum: off (default) | true | chat | passthrough. "chat" stops the
# injection but keeps /v1/images/* alive; "true" also 404s those endpoints.
disable-image-generation: chat
# Expose GPT upstreams under real Anthropic model IDs so Claude Code sends its
# full prompts (system prompt, tool schemas, skill descriptions are trimmed for
# unrecognized model IDs). fork keeps the plain gpt-* names working too.
oauth-model-alias:
  codex:
    - name: "gpt-5.6-sol"
      alias: "claude-opus-4-8"
      fork: true
      force-mapping: true
    # Mid tier: subagents pinned to claude-sonnet-5 (e.g. the loop-engineer
    # harness planner/checker/prover/shipper) resolve to gpt-5.6-terra. Also runs
    # max effort via the gpt-5.6-* override below (no distinct GPT "sonnet" tier).
    - name: "gpt-5.6-terra"
      alias: "claude-sonnet-5"
      fork: true
      force-mapping: true
    # Fast tier: haiku-class subagents (smart-searcher etc.) resolve
    # claude-haiku-4-5 -> gpt-5.3-codex-spark
    - name: "gpt-5.3-codex-spark"
      alias: "claude-haiku-4-5"
      fork: true
      force-mapping: true
payload:
  override:
    # Max effort for the 5.6 tier (sol + terra) - spark stays fast/default
    - models:
        - name: "gpt-5.6-*"
          protocol: "codex"
      params:
        "reasoning.effort": "max"
